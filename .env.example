# このファイルをコピーして .env を作成し、値を書き換えて使う(.env はGitに含めない)
#   cp .env.example .env

# ===== Django =====
# 秘密鍵。次のコマンドで生成した値を設定する
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
# 開発中は True、本番は False
DJANGO_DEBUG=True
# アクセスを許可するホスト名(カンマ区切り)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ===== DB(MySQL) =====
# Django と docker-compose.yml の両方がこの値を使う
DB_NAME=kakeibo
DB_USER=kakeibo
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
# ローカルの MySQL コンテナの管理者パスワード(docker-compose.yml のみで使用)
DB_ROOT_PASSWORD=change-me
